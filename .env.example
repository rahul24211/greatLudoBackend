# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ludo_arena
DB_USER=root
DB_PASSWORD=your_db_password_here

# JWT Secrets & Encryption
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
ENCRYPTION_KEY=your_32_character_aes_encryption_key_here

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Redis Configuration
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
ROOM_RATE_LIMIT_WINDOW_MS=60000
ROOM_RATE_LIMIT_MAX_REQUESTS=15
# Redis Repository TTL Configuration
REDIS_ROOM_TTL_SECONDS=3600
REDIS_GAME_TTL_SECONDS=7200
REDIS_PRESENCE_TTL_SECONDS=300
